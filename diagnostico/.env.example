# Copia este fichero como .env y rellena los dos valores con los del proyecto de PRUEBAS de Supabase.
# El fichero .env no se sube nunca al repositorio (está en .gitignore).
#
# Solo van aquí la dirección del proyecto y la clave PUBLICABLE (empieza por sb_publishable_).
# Lo que protege los datos son las reglas de acceso de supabase/migrations, no esta clave:
# todo lo que lleva la web lo puede leer quien la abra.
#
# La clave SECRETA (empieza por sb_secret_) no va nunca aquí ni con el prefijo VITE_:
# se salta las reglas de acceso y acabaría dentro de la web publicada.

VITE_SUPABASE_URL=https://tu-proyecto-de-pruebas.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_pon_aqui_la_clave_publicable
